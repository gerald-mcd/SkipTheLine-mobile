# Copy to .env (git-ignored) and fill in. Never commit real values.

# Google Maps SDK key for the app (restricted to com.inue.app + Maps SDK for iOS/Android).
# EAS cloud builds don't see this file — also set it there once:
#   eas env:create --name GOOGLE_MAPS_APP_KEY --value <key> --visibility sensitive \
#     --environment development --environment preview --environment production
GOOGLE_MAPS_APP_KEY=

# Server-side only: the "Server – scripts + photos" key, used by scripts/seed-miami.js
# and scripts/patch-reviews-hours.js. No app code reads it. (Legacy EXPO_PUBLIC_ name kept
# so the scripts work unchanged; Expo only bundles EXPO_PUBLIC_ vars that app code references.)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
SUPABASE_SERVICE_ROLE_KEY=
